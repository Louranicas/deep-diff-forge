# A per-user systemd service for the Deep-Diff-Forge daemon.
# Install: cp contrib/systemd/deep-diff-forge.service ~/.config/systemd/user/
#          systemctl --user daemon-reload && systemctl --user enable --now deep-diff-forge
# It expects the binary at ~/.local/bin/deep-diff-forge; edit both Exec lines if it is elsewhere.
# Docs: docs/OPERATIONS_AND_DAEMON.md#running-as-a-service
[Unit]
Description=Deep-Diff-Forge review daemon (this user)
Documentation=https://github.com/Louranicas/deep-diff-forge/blob/main/docs/OPERATIONS_AND_DAEMON.md

[Service]
Type=simple
ExecStart=%h/.local/bin/deep-diff-forge daemon start --log-format json
# `daemon stop` lets the requests in progress finish (up to 30 s) and returns once the daemon
# has exited, so systemd has nothing left to kill.
ExecStop=%h/.local/bin/deep-diff-forge daemon stop
TimeoutStopSec=40
# A stop exits 0; only a failure is restarted.
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
