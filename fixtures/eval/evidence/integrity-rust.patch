 pub fn load(p: &Path) -> Config {
+    let text = std::fs::read_to_string(p).unwrap();
+    let port = text
+        .parse::<u16>()
+        .expect("a port");
+    let fallback = text.parse().unwrap_or(80);
+    match check(port) {
+        Ok(()) => {}
+        Err(_) => {}
+    }
+    Config { port, fallback }
