+pub fn parse(text: &str) -> Option<u32> {
+    text.parse().ok()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn reads_a_number() {
+        assert_eq!(parse("7").unwrap(), 7);
+        let value = parse("8").expect("a number");
+        assert_eq!(value, 8);
+    }
+}
