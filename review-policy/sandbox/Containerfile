# Review council gate image: the only environment in which council quality gates execute candidate code.
# Design/status: docs/REVIEW_COUNCIL.md#gate-sandbox
#
# Build (rootless Podman, network only at build time):
#   podman build --pull=never -t localhost/ddf-council-gate:20261026b -f review-policy/sandbox/Containerfile review-policy/sandbox
# Gates then run this image by image ID with --network=none, a read-only root, a read-only source mount,
# all capabilities dropped, no-new-privileges and no host home mounts; see deep-diff-forge-review/src/sandbox.rs.
# The controller sets RUSTUP_TOOLCHAIN to the stable toolchain below (sandbox.rs STABLE_TOOLCHAIN).

# Base pinned by digest, not tag, so a re-pushed tag cannot change the gate environment.
FROM registry.fedoraproject.org/fedora:44@sha256:0d2a354dfdf7ba75083fe371eb6239842fe13f38c52d339dae1ebcf13c7c4062 AS builder
RUN dnf install -y --setopt=install_weak_deps=False gcc rustup python3 patch && dnf clean all
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:/usr/bin
# Exact toolchains: stable for check/clippy/tests/mutation, a dated nightly for cargo-fuzz.
RUN rustup-init -y --no-modify-path --profile minimal --default-toolchain 1.99.1 \
      --component clippy,rustfmt \
 && rustup toolchain install nightly-2026-10-25 --profile minimal \
 && ln -s nightly-2026-10-25-x86_64-unknown-linux-gnu /opt/rustup/toolchains/nightly-x86_64-unknown-linux-gnu
# `rustup toolchain link` refuses the channel name "nightly"; the symlink makes `cargo +nightly` resolve
# to the dated toolchain without ever updating it.
RUN cargo install --locked cargo-mutants@27.1.0 cargo-fuzz@0.13.2 \
 && rm -rf /opt/cargo/registry /opt/cargo/git
# The exemption oracle's second listing (crates/deep-diff-forge-review/policy/exemption_oracle.py):
# the same cargo-mutants release, from the crates.io archive pinned by the checksum the registry
# index records for 27.1.0, with attribute and `unsafe fn` exclusions switched off by a reviewed
# patch. It only lists; the gate's mutation run always uses the stock build above. A second
# patch builds `ddf-cargo-mutants-strict`, which honours only exact `#[cfg(test)]` and a bare
# `#[test]`: the oracle's allow-list (decision record 1.0.7).
COPY cargo-mutants-noexclude.patch /tmp/noexclude.patch
COPY cargo-mutants-strict.patch /tmp/strict.patch
RUN curl -fsSLo /tmp/cargo-mutants.crate https://static.crates.io/crates/cargo-mutants/cargo-mutants-27.1.0.crate \
 && echo "07072e7bcdeb425d5e5fdbfd9f15a2c749e23cb2edf5ef40aee5876760ae1cf9  /tmp/cargo-mutants.crate" | sha256sum -c - \
 && tar -xzf /tmp/cargo-mutants.crate -C /tmp \
 && patch -d /tmp/cargo-mutants-27.1.0 -p1 < /tmp/noexclude.patch \
 && cargo install --locked --path /tmp/cargo-mutants-27.1.0 --root /tmp/noexclude \
 && install -m 0755 /tmp/noexclude/bin/cargo-mutants /opt/cargo/bin/ddf-cargo-mutants-noexclude \
 && rm -rf /tmp/cargo-mutants-27.1.0 && tar -xzf /tmp/cargo-mutants.crate -C /tmp \
 && patch -d /tmp/cargo-mutants-27.1.0 -p1 < /tmp/strict.patch \
 && cargo install --locked --path /tmp/cargo-mutants-27.1.0 --root /tmp/strict \
 && install -m 0755 /tmp/strict/bin/cargo-mutants /opt/cargo/bin/ddf-cargo-mutants-strict \
 && rm -rf /tmp/cargo-mutants* /tmp/noexclude* /tmp/strict* /opt/cargo/registry /opt/cargo/git

FROM registry.fedoraproject.org/fedora:44@sha256:0d2a354dfdf7ba75083fe371eb6239842fe13f38c52d339dae1ebcf13c7c4062
# gcc-c++: libfuzzer-sys compiles C++ through cc-rs (measured: r4 fuzz gate "failed to find tool c++").
# git-core: the workspace's own tests build fixture repositories (measured: council r4's tests gate
# failed closed with "No such file or directory" for every Git-backed fixture without it).
RUN dnf install -y --setopt=install_weak_deps=False gcc gcc-c++ python3 git-core && dnf clean all
COPY --from=builder /opt/rustup /opt/rustup
COPY --from=builder /opt/cargo/bin /opt/cargo/bin
# Positive control for the read-only-root probe (tests/council_sandbox.rs): owned by the gate user, so
# only --read-only stops a write here, and the probe can tell EROFS from a permission refusal.
RUN install -d -o 1000 -g 1000 -m 0755 /opt/ddf-probe-writable
ENV RUSTUP_HOME=/opt/rustup PATH=/opt/cargo/bin:/usr/bin LANG=C.UTF-8
# Runtime is always --userns=keep-id; never root inside the gate.
USER 1000:1000
WORKDIR /src
